#=========================================================================
# 15. 按需开启（基座未启用，如需请取消注释）
#=========================================================================
#
# ⚠ 基座里这些只有 CONFIG_MODULE_DEFAULT_ 标记（不参与编译），因此本配置不含它们：
#   kmod-phy-airoha-en8811h（2.5G PHY）、kmod-phy-realtek、kmod-phy-maxlinear、
#   rtl826x-firmware、airoha-en8811h-firmware、
#   kmod-mt7915e / kmod-mt7916-firmware（WiFi）、wpad-openssl、znxt-zn515-mt7916-eeprom
# 若你的机型需要 2.5G 网口或 WiFi，把对应行取消注释：
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y      # 2.5G PHY
CONFIG_PACKAGE_airoha-en8811h-firmware=m      # EN8811H MD32 固件
# CONFIG_PACKAGE_kmod-mt7915e=m                 # MT7915/MT7916 WiFi 驱动
# CONFIG_PACKAGE_kmod-mt7916-firmware=m         # MT7916 WiFi 固件
# CONFIG_PACKAGE_wpad-openssl=m                 # WPA 认证
#
# --- 文件系统 / USB / eMMC / M.2 ---
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fs-vfat=m
CONFIG_PACKAGE_kmod-usb3=m
CONFIG_PACKAGE_kmod-usb-storage=m
CONFIG_PACKAGE_kmod-usb-storage-uas=m
CONFIG_PACKAGE_block-mount=m
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_gdisk=y
# CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_kmod-mmc=m
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_kmod-nvme=m
#
# --- 其他常用（基座未含）---
# CONFIG_PACKAGE_uboot-envtools=y               # 读写 u-boot 环境变量
 CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_zram-swap=y
# CONFIG_PACKAGE_kmod-zram=y
#
# ---其他个人配置----

