#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# natmode —— 开机 / 防火墙重载后重新应用 NAT 模式
#
# START=25 必须晚于 firewall（START=19），否则对称型插到 fw4 里的
# fully-random 规则会被随后的 fw4 reload 清掉。

START=25
STOP=90

USE_PROCD=1

start_service() {
	/usr/sbin/natmode-apply apply >/dev/null 2>&1
}

reload_service() {
	/usr/sbin/natmode-apply apply >/dev/null 2>&1
}

stop_service() {
	# 退出时移除 fully-random，避免残留影响后续手动改防火墙
	uci -q get natmode.main.mode >/dev/null 2>&1 || return 0
	return 0
}

boot() {
	/usr/sbin/natmode-apply apply >/dev/null 2>&1
}

service_triggers() {
	# firewall 重载时同步重新应用（用户改防火墙不会丢掉 NAT 模式）
	procd_add_reload_trigger firewall
}
